# Claude Code internal files — track team config, exclude personal/internal state
.claude/*
!.claude/settings.json
!.claude/agents/
!.claude/agents/**
!.claude/commands/
!.claude/commands/**
# Route plans must be tracked: the PR evidence gates require a changed
# .claude/plans/*.md in the diff, and lib/plan-time.sh dates a committed plan from
# git history. Without this negation a newly created plan is silently ignored, so it
# reaches neither. The existing plans predate the .claude/* rule above.
!.claude/plans/
!.claude/plans/**

# Graphify knowledge graph (rebuilt each session via session-setup.sh)
graphify-out/

# Python bytecode cache
__pycache__/
*.pyc

# Local runtime telemetry baseline (raw session events; export via
# scripts/monitoring/export-telemetry-run.py for the metadata-only archive
# bundle instead of committing raw local state directly)
.engineering-os/
